rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // 2. Entity Validation Blueprints (Auth-First + Anti-Update-Gap)
    function isValidContributorProfile(data) {
      return isSignedIn() &&
        data.keys().hasAll([
          'uid', 'displayName', 'communityId', 'communityName', 'region', 'bio', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'communityId', 'communityName', 'region', 'bio', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80 &&
        data.communityId is string && data.communityId.size() >= 2 && data.communityId.size() <= 80 && data.communityId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.communityName is string && data.communityName.size() >= 2 && data.communityName.size() <= 80 &&
        data.region is string && data.region.size() >= 2 && data.region.size() <= 80 &&
        data.bio is string && data.bio.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return isSignedIn() &&
        data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.createdAt is timestamp;
    }

    function isValidVerifiedBroadcast(data) {
      return isSignedIn() &&
        data.keys().hasAll([
          'id', 'authorId', 'authorName', 'communityId', 'communityName',
          'distributionScope', 'title', 'description', 'category', 'location',
          'language', 'videoUrl', 'complianceStatus', 'complianceScore',
          'complianceReasoning', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorId', 'authorName', 'communityId', 'communityName',
          'distributionScope', 'title', 'description', 'category', 'location',
          'language', 'videoUrl', 'complianceStatus', 'complianceScore',
          'complianceReasoning', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.communityId is string && data.communityId.size() >= 2 && data.communityId.size() <= 80 && data.communityId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.communityName is string && data.communityName.size() >= 2 && data.communityName.size() <= 80 &&
        data.distributionScope is string && data.distributionScope.size() <= 32 &&
        (data.distributionScope == 'PUBLIC' || data.distributionScope == 'COMMUNITY_ONLY') &&
        data.title is string && data.title.size() >= 5 && data.title.size() <= 140 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 1200 &&
        data.category is string && data.category.size() <= 32 &&
        (
          data.category == 'NEWS' ||
          data.category == 'LIVE_NEWS' ||
          data.category == 'DOCUMENTARY' ||
          data.category == 'EDUCATION' ||
          data.category == 'SCIENCE' ||
          data.category == 'PUBLIC_SERVICE' ||
          data.category == 'COMMUNITY'
        ) &&
        data.location is string && data.location.size() >= 2 && data.location.size() <= 100 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 40 &&
        data.videoUrl is string && data.videoUrl.size() >= 5 && data.videoUrl.size() <= 600 &&
        data.complianceStatus is string && data.complianceStatus.size() <= 16 &&
        data.complianceStatus == 'APPROVED' &&
        data.complianceScore is number && data.complianceScore >= 70 && data.complianceScore <= 100 &&
        data.complianceReasoning is string && data.complianceReasoning.size() >= 5 && data.complianceReasoning.size() <= 600 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 3. Contributor Public Profile (Owner-Managed, No PII)
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        isValidContributorProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(userId)/private/info);

      allow update: if isValidContributorProfile(incoming()) &&
        isVerifiedUser() &&
        request.auth.uid == userId &&
        isValidId(userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'communityId', 'communityName', 'region', 'bio', 'updatedAt'
          ])
        );

      allow delete: if false;

      // 4. Isolated PII Subcollection (Master Gate + Owner-Only Access)
      match /private/{docId} {
        allow get: if isSignedIn() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if false;

        allow create: if isVerifiedUser() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().createdAt == request.time &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isValidUserPrivateInfo(incoming()) &&
          isVerifiedUser() &&
          request.auth.uid == userId &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['email'])
          );

        allow delete: if false;
      }
    }

    // 5. AI-Vetted Journalistic News & Humanitarian Documentaries
    match /broadcasts/{broadcastId} {
      allow get: if isValidId(broadcastId) &&
        existing().complianceStatus == 'APPROVED' &&
        (
          existing().distributionScope == 'PUBLIC' ||
          (isSignedIn() && existing().authorId == request.auth.uid) ||
          (
            isSignedIn() &&
            existing().distributionScope == 'COMMUNITY_ONLY' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.communityId == existing().communityId
          )
        );

      allow list: if resource.data.complianceStatus == 'APPROVED' &&
        (
          resource.data.distributionScope == 'PUBLIC' ||
          (isSignedIn() && resource.data.authorId == request.auth.uid) ||
          (
            isSignedIn() &&
            resource.data.distributionScope == 'COMMUNITY_ONLY' &&
            resource.data.communityId is string &&
            resource.data.communityId.size() >= 2
          )
        );

      allow create: if isVerifiedUser() &&
        isValidId(broadcastId) &&
        isValidVerifiedBroadcast(incoming()) &&
        incoming().id == broadcastId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isValidVerifiedBroadcast(incoming()) &&
        isVerifiedUser() &&
        isValidId(broadcastId) &&
        existing().authorId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().authorId == existing().authorId &&
        incoming().videoUrl == existing().videoUrl &&
        incoming().category == existing().category &&
        incoming().complianceStatus == existing().complianceStatus &&
        incoming().complianceScore == existing().complianceScore &&
        incoming().complianceReasoning == existing().complianceReasoning &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['distributionScope', 'updatedAt'])
        );

      allow delete: if isVerifiedUser() &&
        isValidId(broadcastId) &&
        existing().authorId == request.auth.uid;
    }
  }
}
